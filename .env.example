# Django
DJANGO_SECRET_KEY=django-insecure-change-this-key
DJANGO_DEBUG=True

# Módulo de desarrollador: panel de fallos simulados para QA (solo admin).
# Dejar en False en producción — al cambiarlo en Azure la app se reinicia.
ENABLE_FAULT_INJECTION=False

# Minutos de inactividad hasta que expira la sesión (por defecto 60).
# Para probar CP005-B usar "Sesión corta" en el módulo de desarrollador
# (se activa al instante); cambiar esta variable reinicia la app.
SESSION_TIMEOUT_MINUTES=60

# Hosts permitidos (separados por coma, sin espacios)
# Ejemplo: ALLOWED_HOSTS=mi-app.azurewebsites.net,localhost
ALLOWED_HOSTS=

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# PostgreSQL (dejar vacío para usar SQLite en desarrollo local)
# Azure: DB_HOST=soc-nist-db.postgres.database.azure.com
# Github Actions (Colocar el perfil de publicación en el secrets de Github)
DB_NAME=soc_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
# require (Azure / producción) | disable (Postgres local sin SSL)
DB_SSLMODE=require
