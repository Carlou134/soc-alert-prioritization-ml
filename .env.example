# Django
DJANGO_SECRET_KEY=django-insecure-change-this-key
DJANGO_DEBUG=True

# Hosts permitidos (separados por coma, sin espacios)
# Ejemplo: ALLOWED_HOSTS=mi-app.azurewebsites.net,localhost
ALLOWED_HOSTS=

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# PostgreSQL (dejar vacío para usar SQLite en desarrollo local)
# Azure: DB_HOST=soc-nist-db.postgres.database.azure.com
DB_NAME=soc_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
